@using Mobify.BLL.ModelVM.CategoryVM
@model CategoryVM

@{
    ViewData["Title"] = "Create Category";
}

<div class="admin-card" style="max-width: 600px; margin: 0 auto;">
    <div class="admin-card-header">
        <div>
            <h4 class="mb-1"><i class="bi bi-plus-circle-fill me-2"></i>Create Category</h4>
            <small class="text-muted">Add a new product category</small>
        </div>
    </div>
    <div class="admin-card-body">
        <form asp-action="ConfirmAdd" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-semibold">Category Name</label>
                <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Smartphones, Laptops..." />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-create">
                    <i class="bi bi-check-lg me-1"></i> Create
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-right me-1"></i> Add
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
