@using Mobify.BLL.ModelVM.CategoryVM
@model List<CategoryVM>

@{
    ViewData["Title"] = "Categories";
}

<!-- Success / Error Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="admin-card">
    <div class="admin-card-header">
        <div>
            <h4 class="mb-1"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Categories</h4>
            <small class="text-muted">Manage all product categories</small>
        </div>
        <a asp-action="Create" class="btn btn-create">
            <i class="bi bi-plus-lg me-1"></i> Add Category
        </a>
    </div>

    <div class="admin-card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table admin-table" id="categoriesTable">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Name</th>
                            <th style="width: 200px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td class="fw-semibold text-muted">@(i + 1)</td>
                                <td>
                                    <span class="category-name">@Model[i].Name</span>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <a asp-action="Edit" asp-route-id="@Model[i].Id"
                                           class="btn btn-sm btn-action btn-edit" title="Edit">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@Model[i].Id"
                                           class="btn btn-sm btn-action btn-delete" title="Delete">
                                            <i class="bi bi-trash3"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="admin-card-footer">
                <span class="text-muted"><i class="bi bi-info-circle me-1"></i>Total: <strong>@Model.Count</strong> categories</span>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox" style="font-size: 3rem; color: #c0c5ce;"></i>
                <h5 class="mt-3 text-muted">No categories yet</h5>
                <p class="text-muted">Get started by adding your first category.</p>
                <a asp-action="Create" class="btn btn-create">
                    <i class="bi bi-plus-lg me-1"></i> Add Category
                </a>
            </div>
        }
    </div>
</div>