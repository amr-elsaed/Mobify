    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ═══════════════════════ FOOTER ═══════════════════════ -->
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <!-- About -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-widget">
                        <a href="#" class="footer-logo">
                            <i class="bi bi-phone-fill"></i>
                            <span>Mob<span class="logo-accent">ify</span></span>
                        </a>
                        <p class="footer-about">
                            Your one-stop destination for the latest mobile phones, tablets, and accessories. We provide detailed specifications, honest reviews, and the best deals to help you make the right choice.
                        </p>
                        <div class="footer-social">
                            <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                            <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                            <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        </div>
                    </div>
                </div>
                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6 col-6">
                    <div class="footer-widget">
                        <h5 class="footer-widget__title">Quick Links</h5>
                        <ul class="footer-links">
                            <li><a href="#">About Us</a></li>
                            <li><a href="#">Contact Us</a></li>
                            <li><a href="#">Blog & News</a></li>
                            <li><a href="#">Careers</a></li>
                            <li><a href="#">Affiliate Program</a></li>
                        </ul>
                    </div>
                </div>
                <!-- Customer Support -->
                <div class="col-lg-2 col-md-6 col-6">
                    <div class="footer-widget">
                        <h5 class="footer-widget__title">Support</h5>
                        <ul class="footer-links">
                            <li><a href="#">Help Center</a></li>
                            <li><a href="#">Track Order</a></li>
                            <li><a href="#">Shipping Info</a></li>
                            <li><a href="#">Returns & Refunds</a></li>
                            <li><a href="#">Warranty Policy</a></li>
                        </ul>
                    </div>
                </div>
                <!-- Contact Info -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-widget">
                        <h5 class="footer-widget__title">Get in Touch</h5>
                        <ul class="footer-contact">
                            <li>
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>123 Tech Avenue, Silicon Valley, CA 94025</span>
                            </li>
                            <li>
                                <i class="bi bi-telephone-fill"></i>
                                <span>1-800-MOBIFY (662-4393)</span>
                            </li>
                            <li>
                                <i class="bi bi-envelope-fill"></i>
                                <span>support@mobify.com</span>
                            </li>
                            <li>
                                <i class="bi bi-clock-fill"></i>
                                <span>Mon – Sat: 9:00 AM – 8:00 PM</span>
                            </li>
                        </ul>
                        <div class="footer-payments">
                            <span>We Accept:</span>
                            <div class="payment-icons">
                                <i class="bi bi-credit-card-2-back-fill" title="Visa"></i>
                                <i class="bi bi-credit-card-fill" title="Mastercard"></i>
                                <i class="bi bi-paypal" title="PayPal"></i>
                                <i class="bi bi-wallet2" title="Apple Pay"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <p>&copy; 2026 Mobify. All rights reserved.</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="footer-bottom__links">
                            <a href="#">Privacy Policy</a>
                            <a href="#">Terms of Service</a>
                            <a href="#">Cookie Settings</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Back to Top Button -->
    <button class="back-to-top" id="backToTop" aria-label="Back to top">
        <i class="bi bi-chevron-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
