<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mobify</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Mobify.PL.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/styles.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>


    <!-- ═══════════════════════ TOP BAR ═══════════════════════ -->
    <div class="top-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="top-bar__promo">
                <i class="bi bi-lightning-charge-fill"></i>
                Free shipping on orders over $99 — <a href="#">Shop Now</a>
            </span>
            <div class="top-bar__links d-none d-md-flex">
                <a href="#"><i class="bi bi-geo-alt"></i> Track Order</a>
                <a href="#"><i class="bi bi-question-circle"></i> Help Center</a>
                <a href="#"><i class="bi bi-globe"></i> EN</a>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════ HEADER ═══════════════════════ -->
    <header class="site-header" id="siteHeader">
        <div class="container d-flex align-items-center justify-content-between">
            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="site-header__logo">
                <i class="bi bi-phone-fill"></i>
                <span>Mob<span class="logo-accent">ify</span></span>
            </a>

            <!-- Header Actions -->
            <div class="site-header__actions">
                <button class="header-action d-lg-none" id="searchToggle" aria-label="Toggle search">
                    <i class="bi bi-search"></i>
                </button>
                <a href="#" class="header-action" data-bs-toggle="tooltip" title="Wishlist">
                    <i class="bi bi-heart"></i>
                    <span class="action-badge">3</span>
                </a>
                <a href="#" class="header-action" data-bs-toggle="tooltip" title="Compare">
                    <i class="bi bi-arrow-left-right"></i>
                    <span class="action-badge">2</span>
                </a>
                <a href="#" class="header-action cart-action" data-bs-toggle="tooltip" title="Cart">
                    <i class="bi bi-cart3"></i>
                    <span class="action-badge">5</span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="auth-status">
                        <span class="auth-user-pill" title="@User.Identity.Name">
                            <i class="bi bi-person-circle"></i>
                            <span class="auth-user-name">@User.Identity.Name</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="auth-logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="auth-logout-btn" title="Logout" aria-label="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="auth-link auth-link--ghost" title="Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Login</span>
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="auth-link auth-link--primary" title="Register">
                        <i class="bi bi-person-plus"></i>
                        <span>Register</span>
                    </a>
                }
            </div>
        </div>

        <!-- Mobile Search (hidden by default) -->
        <div class="mobile-search" id="mobileSearch">
            <div class="container">
                <div class="search-wrapper">
                    <input type="text" class="search-input" placeholder="Search Mobify...">
                    <button class="search-btn" aria-label="Search">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- ═══════════════════════ NAVBAR ═══════════════════════ -->
    <nav class="main-nav" id="mainNav">
        <div class="container d-flex align-items-center">
            <!-- Mobile menu toggle -->
            <button class="nav-toggler d-lg-none" id="sidebarToggle" aria-label="Toggle sidebar">
                <i class="bi bi-list"></i>
                <span>Menu</span>
            </button>

            <ul class="main-nav__list d-none d-lg-flex">
                <li class="nav-item active">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a>
                </li>
                <li class="nav-item dropdown">
                    <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-phone"></i> Mobiles
                    </a>
                    <ul class="dropdown-menu mega-menu">
                        <li class="mega-menu__inner">
                            <div class="row">
                                <div class="col-md-3">
                                    <h6 class="mega-menu__title">By Brand</h6>
                                    <a href="#">Apple iPhone</a>
                                    <a href="#">Samsung Galaxy</a>
                                    <a href="#">Google Pixel</a>
                                    <a href="#">OnePlus</a>
                                    <a href="#">Xiaomi</a>
                                </div>
                                <div class="col-md-3">
                                    <h6 class="mega-menu__title">By Price</h6>
                                    <a href="#">Under $200</a>
                                    <a href="#">$200 – $500</a>
                                    <a href="#">$500 – $800</a>
                                    <a href="#">$800 – $1200</a>
                                    <a href="#">Flagship ($1200+)</a>
                                </div>
                                <div class="col-md-3">
                                    <h6 class="mega-menu__title">By Feature</h6>
                                    <a href="#">Best Camera</a>
                                    <a href="#">Best Battery</a>
                                    <a href="#">5G Phones</a>
                                    <a href="#">Gaming Phones</a>
                                    <a href="#">Foldable Phones</a>
                                </div>
                                <div class="col-md-3">
                                    <h6 class="mega-menu__title">Popular</h6>
                                    <a href="#">New Arrivals</a>
                                    <a href="#">Best Sellers</a>
                                    <a href="#">Top Rated</a>
                                    <a href="#">Deals of the Day</a>
                                    <a href="#">Compare Phones</a>
                                </div>
                            </div>
                        </li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-tablet"></i> Tablets
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Apple iPad</a></li>
                        <li><a class="dropdown-item" href="#">Samsung Galaxy Tab</a></li>
                        <li><a class="dropdown-item" href="#">Microsoft Surface</a></li>
                        <li><a class="dropdown-item" href="#">Amazon Fire</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#">View All Tablets</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-headphones"></i> Accessories
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Cases & Covers</a></li>
                        <li><a class="dropdown-item" href="#">Screen Protectors</a></li>
                        <li><a class="dropdown-item" href="#">Chargers & Cables</a></li>
                        <li><a class="dropdown-item" href="#">Earbuds & Headphones</a></li>
                        <li><a class="dropdown-item" href="#">Smartwatches</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#">View All Accessories</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-deals">
                        <i class="bi bi-tag-fill"></i> Deals
                        <span class="deals-badge">HOT</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#"><i class="bi bi-arrow-left-right"></i> Compare</a>
                </li>
                <li class="nav-item">
                    <a href="#"><i class="bi bi-newspaper"></i> Tech News</a>
                </li>
            </ul>

            <!-- Phone number on large screens -->
            <div class="nav-phone d-none d-xl-flex">
                <i class="bi bi-telephone-fill"></i>
                <span>1-800-MOBIFY</span>
            </div>
        </div>
    </nav>

    <!-- ═══════════════════════ SIDEBAR OVERLAY ═══════════════════════ -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>



