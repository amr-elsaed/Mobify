<!-- NEWSLETTER SECTION -->
<section class="mb-5">
    <div class="bg-primary text-white rounded-5 p-5 position-relative overflow-hidden shadow-sm">
        <div class="row align-items-center position-relative z-1">
            <div class="col-md-6 mb-4 mb-md-0">
                <h3 class="fw-bold mb-2">Join Our Newsletter</h3>
                <p class="opacity-75 mb-0">Subscribe to get special offers, free giveaways, and once-in-a-lifetime deals.</p>
            </div>
            <div class="col-md-6">
                <form id="newsletterForm" class="d-flex bg-white rounded-pill p-1 shadow-sm mx-auto" style="max-width: 450px;">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input type="email" id="newsletterEmail" class="form-control border-0 shadow-none ps-2 py-3" placeholder="Enter your email" required>
                        <button class="btn btn-primary rounded-pill px-4 m-1 fw-bold" type="submit">Subscribe</button>
                    </div>
                </form>
                <div id="newsletterMsg" class="text-center mt-2 small fw-bold" style="min-height: 20px;"></div>
            </div>
        </div>
        <div class="position-absolute bottom-0 start-0 translate-middle-y text-white opacity-10" style="font-size: 25rem; left: -5%; z-index: 0; pointer-events: none;">
            <i class="bi bi-mailbox"></i>
        </div>
    </div>
</section>

<!-- CART TOAST -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1055">
  <div id="cartToast" class="toast hide shadow" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="toast-header bg-surface border-bottom border-light">
      <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
      <strong class="me-auto text-secondary">Cart Updated</strong>
      <small class="text-muted">Just now</small>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
    <div class="toast-body bg-white text-muted fw-bold">
      Item successfully added to your cart!
    </div>
  </div>
</div>

