            <div class="col">
                <div class="card product-card h-100 shadow-sm border-0 bg-surface position-relative overflow-hidden group">
                    <div class="position-absolute top-0 end-0 m-3 z-2">
                        <button class="btn btn-light btn-sm rounded-circle shadow-sm text-muted hover-text-danger" style="width: 35px; height: 35px;"><i class="bi bi-heart"></i></button>
                    </div>
                    
                    <a href="#" class="text-center p-4 text-decoration-none d-block overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1606220588913-b3aacb4b2f46?q=80&w=400&auto=format&fit=crop" alt="Sony Headphones" class="product-card__image img-fluid" style="object-fit: contain; max-height: 180px; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
                    </a>
                    
                    <div class="card-body pt-0 d-flex flex-column">
                        <div class="mb-2">
                            <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Sony</span>
                        </div>
                        <h5 class="card-title product-name fs-6 fw-bold mb-2">
