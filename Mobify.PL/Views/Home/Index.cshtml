                            <button class="btn btn-primary btn-sm rounded-circle shadow-sm btn-add-cart" style="width: 40px; height: 40px;" title="Add to Cart">
                                <i class="bi bi-cart-plus fs-5"></i>
                            </button>
                        </div>
                    </div>
