function loadProducts(page = 1)
{
    const params = new URLSearchParams();

    params.append("ProductCardQueryVM.Search",
        document.getElementById("searchInput")?.value || "");

    params.append("ProductCardQueryVM.Price",
        document.getElementById("priceRange")?.value || "");

    params.append("ProductCardQueryVM.Sort",
        document.getElementById("sortSelect")?.value || "");

    params.append("ProductCardQueryVM.Page", page);

    if (selectedCategory)
        params.append("ProductCardQueryVM.CategoryId", selectedCategory);

    const brands = [...document.querySelectorAll(".brand-filter-input:checked")]
        .map(x => x.value);

    if (brands.length > 0)
        params.append("ProductCardQueryVM.BrandId", brands.join(","));

    fetch("/Home/Index?" + params.toString(), {
        headers: {
            "X-Requested-With": "XMLHttpRequest"
        }
    })
    .then(res => res.text())
    .then(html => {

        document.getElementById("productsContainer").innerHTML = html;

    });
}

        function debounce(func, delay) {
            let timer;
            return function () {
                clearTimeout(timer);
                timer = setTimeout(() => {
                    func();
                }, delay);
            }
        }

        //connect with ajax call
        const searchInput = document.getElementById("searchInput");
        const searchBtn = document.getElementById("searchBtn");
        searchBtn.addEventListener("click", loadProducts);
        searchInput.addEventListener("input", debounce(loadProducts, 500));
        //category
        document.querySelectorAll(".category-filter")
        .forEach(btn => {

            btn.addEventListener("click", function(e){

                e.preventDefault();

                selectedCategory = this.dataset.category;

                loadProducts();

            });

        });
        
        //Brand
         document.querySelectorAll(".brand-filter-input")
        .forEach(x => {

            x.addEventListener("change", function(){

                loadProducts();

            });

        });

        //Price
        document.getElementById("priceRange").addEventListener("change", loadProducts);
        const priceSlider = document.getElementById("priceRange");
        const priceLabel = document.getElementById("priceValue");

        priceSlider.addEventListener("input", function(){

            priceLabel.textContent = "$" + this.value;

        });

        //Category Just One Choise
        document.querySelectorAll(".category-filter").forEach(item => {

            item.addEventListener("click", function (e) {

                e.preventDefault();

                document.querySelectorAll(".category-filter")
                    .forEach(x => x.classList.remove("active"));

                this.classList.add("active");

                const categoryId = this.dataset.category;

                console.log("Selected Category:", categoryId);

            });

        });
</script>



</body>

</html>
