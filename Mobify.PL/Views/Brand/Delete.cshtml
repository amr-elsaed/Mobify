@using Mobify.BLL.ModelVM.BrandVM
@model ShowBrandVM
@{
    ViewData["Title"] = "Delete Brand";
}

<div class="admin-card" style="max-width: 600px; margin: 0 auto;">
    <div class="admin-card-header" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
        <div>
            <h4 class="mb-1 text-white"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Brand</h4>
            <small class="text-white-50">This action cannot be undone</small>
        </div>
    </div>
    <div class="admin-card-body text-center py-5">
        <i class="bi bi-trash3" style="font-size: 3rem; color: #e74c3c;"></i>
        <h5 class="mt-3">Are you sure you want to delete this brand?</h5>
        <p class="text-muted mb-1">Brand Name:</p>
        <h4 class="mb-2"><span class="badge bg-secondary fs-6">@Model.Name</span></h4>

        @if (!string.IsNullOrEmpty(Model.imgURL))
        {
            <img src="~/BrandPhotoes/@Model.imgURL" alt="@Model.Name" class="img-fluid mb-3" style="max-height: 150px;">
        }

        <form asp-action="ConfirmDelete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id"/>
            <input type="hidden" asp-for="imgURL"/>
            <div class="d-flex justify-content-center gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3 me-1"></i> Yes, Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>
