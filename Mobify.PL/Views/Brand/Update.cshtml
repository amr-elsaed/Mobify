@using Mobify.BLL.ModelVM.BrandVM
@model EditBrandVM

@{
    ViewData["Title"] = "Edit Brand";
}

<div class="admin-card" style="max-width: 600px; margin: 0 auto;">
    <div class="admin-card-header">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-pencil-square me-2"></i>Edit Brand
            </h4>
            <small class="text-muted">Update the brand details</small>
        </div>
    </div>

    <div class="admin-card-body">
        <form asp-action="Update" method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <!-- Hidden ID -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="currentPhoto" />
            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 style="display:none;">
            </div>

            <!-- Brand Name -->
            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-semibold">
                    Brand Name
                </label>
                <input asp-for="Name" class="form-control form-control-lg" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <!-- Current Image -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Current Image</label>
                <div>
                    <img src="~/BrandPhotoes/@Model.currentPhoto"
                         alt="Brand Image"
                         class="img-thumbnail"
                         style="max-height: 150px;" />
                </div>
            </div>
            <!-- Upload New Image -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Upload New Image (Optional)
                </label>
                <input asp-for="formfile"
                       class="form-control" />
            </div>

            <!-- Buttons -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning text-white">
                    <i class="bi bi-check-lg me-1"></i> Save Changes
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}